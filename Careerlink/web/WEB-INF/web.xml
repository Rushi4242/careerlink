<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" 
         version="4.0">

    <!-- ADD THIS CONFIGURATION TO ALLOW JSP FILE UPLOADS -->
    <servlet>
        <servlet-name>UploadResumePage</servlet-name>
        <jsp-file>/upload_resume.jsp</jsp-file>
        <multipart-config>
            <!-- Max file size allowed: 10MB -->
            <max-file-size>10485760</max-file-size> 
            <!-- Max request size allowed: 20MB -->
            <max-request-size>20971520</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>UploadResumePage</servlet-name>
        <url-pattern>/upload_resume.jsp</url-pattern>
    </servlet-mapping>
    <!-- END OF FILE UPLOAD CONFIGURATION -->

</web-app>